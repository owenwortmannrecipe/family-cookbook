+/* ===== Import recipes from a file (also restores a backup) ===== */
+var importRows=[];
+function cleanText(v,max){return String(v==null?'':v).replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f]/g,'').trim().slice(0,max);}
+function allowedValues(sel){return Array.prototype.map.call(document.querySelectorAll(sel),function(o){return o.value;}).filter(Boolean);}
+function firstNum(v){var m=/(\d+(?:\.\d+)?)/.exec(String(v==null?'':v));return m?String(Math.round(parseFloat(m[1])*100)/100):'';}
+/* never trust a file: keep only the fields a recipe has, with sane types and sizes */
+function sanitizeRecipe(r){
+  if(!r||typeof r!=='object'||Array.isArray(r)||r.deleted)return null;
+  var name=cleanText(r.name,120);if(!name)return null;
+  var cats=allowedValues('#f_cat option'),cuis=allowedValues('#f_cuisine option'),dietsOk=allowedValues('.diet-check input');
+  var ing=(Array.isArray(r.ingredients)?r.ingredients:[]).slice(0,100).map(function(i){
+    if(typeof i==='string')i=WFC.parseIngredient(i);
+    if(!i||typeof i!=='object')return null;
+    var n=cleanText(i.name,200);if(!n)return null;
+    return{name:n,qty:cleanText(i.qty,20),unit:cleanText(i.unit,20)};
+  }).filter(Boolean);
+  var steps=(Array.isArray(r.steps)?r.steps:[]).slice(0,80).map(function(x){return cleanText(x,2000);}).filter(Boolean);
+  var photo=cleanText(r.photo,400000);
+  if(!(/^https?:\/\//i.test(photo)&&photo.length<=2000)&&!/^data:image\/(jpeg|png|webp|gif);base64,/i.test(photo))photo='';
+  var src=cleanText(r.sourceUrl,1000);if(!/^https?:\/\//i.test(src))src='';
+  return{name:name,category:cats.indexOf(r.category)>=0?r.category:'',cuisine:cuis.indexOf(r.cuisine)>=0?r.cuisine:'',
+    author:cleanText(r.author,60),servings:firstNum(r.servings),active:firstNum(r.active),passive:firstNum(r.passive),
+    photo:photo,description:cleanText(r.description,2000),cal:firstNum(r.cal),protein:firstNum(r.protein),carbs:firstNum(r.carbs),fat:firstNum(r.fat),
+    pairings:cleanText(r.pairings,300),sourceUrl:src,diets:(Array.isArray(r.diets)?r.diets:[]).filter(function(d){return dietsOk.indexOf(d)>=0;}),
+    tags:parseTags(Array.isArray(r.tags)?r.tags.join(','):r.tags),ingredients:ing,steps:steps};
+}
+function importMsg(kind,html){document.getElementById('importPreview').innerHTML='<div class="imp-msg '+kind+'">'+html+'</div>';}
+async function loadImportFile(input){
+  var file=input.files&&input.files[0];if(!file)return;
+  importRows=[];
+  if(file.size>8*1024*1024){importMsg('err','❌ That file is too large to be a recipe file.');return;}
+  var data;
+  try{data=JSON.parse(await file.text());}
+  catch(e){importMsg('err','❌ That doesn’t look like a recipe file. Choose a <strong>.json</strong> file — a backup from this cookbook, or one you were given.');return;}
+  var list=Array.isArray(data)?data:(data&&Array.isArray(data.recipes)?data.recipes:null);
+  if(!list){importMsg('err','❌ I couldn’t find any recipes in that file.');return;}
+  var skipped=0;
+  list.forEach(function(r){
+    var c=sanitizeRecipe(r);
+    if(!c){skipped++;return;}
+    var dup=findDuplicate(c);
+    importRows.push({data:c,dup:dup?dup.name:'',on:!dup});
+  });
+  renderImportPreview(skipped);
+}
+function renderImportPreview(skipped){
+  var box=document.getElementById('importPreview');
+  if(!importRows.length){importMsg('err','❌ No usable recipes in that file'+(skipped?' ('+skipped+' skipped: no name, or already in the Trash)':'')+'.');return;}
+  var n=importRows.filter(function(r){return r.on;}).length;
+  box.innerHTML='<div class="imp-head">Found <strong>'+importRows.length+'</strong> recipe'+(importRows.length!==1?'s':'')+(skipped?' <span style="color:var(--ink3)">('+skipped+' skipped)</span>':'')+'. Untick any you don’t want.</div>'+
+    importRows.map(function(r,i){
+      var d=r.data;
+      return'<label class="imp-row"><input type="checkbox" '+(r.on?'checked':'')+' onchange="toggleImportRow('+i+')"><span><strong>'+h(d.name)+'</strong><small>'+[d.category,d.ingredients.length+' ingredient'+(d.ingredients.length!==1?'s':''),d.steps.length+' step'+(d.steps.length!==1?'s':'')].filter(Boolean).map(h).join(' · ')+'</small>'+(r.dup?'<em class="imp-dup">Already in your cookbook (“'+h(r.dup)+'”) — unticked so it isn’t doubled</em>':'')+'</span></label>';
+    }).join('')+
+    '<div class="imp-actions"><button class="btn btn-primary" id="importGo" onclick="runImport()"'+(n?'':' disabled')+'>Import '+n+' recipe'+(n!==1?'s':'')+'</button><button class="btn" onclick="cancelImport()">Cancel</button></div>';
+}
+function toggleImportRow(i){importRows[i].on=!importRows[i].on;renderImportPreview(0);}
+function cancelImport(){importRows=[];document.getElementById('importFile').value='';document.getElementById('importPreview').innerHTML='';}
+async function runImport(){
+  var todo=importRows.filter(function(r){return r.on;});
+  if(!todo.length)return;
+  if(!dbReady){showToast('⚠️ Still connecting — try again in a moment');return;}
+  var f=window._fns,btn=document.getElementById('importGo'),ok=0,failed=0;
+  btn.disabled=true;
+  for(var i=0;i<todo.length;i++){
+    btn.textContent='Importing… '+(i+1)+' of '+todo.length;
+    var d=Object.assign({},todo[i].data);
+    d.author=d.author||myName();d.addedByUid=window._myUid||'';d.createdAt=f.serverTimestamp();
+    try{await f.addDoc(window._col,d);ok++;}catch(e){console.error(e);failed++;}
+  }
+  importRows=[];document.getElementById('importFile').value='';
+  importMsg(failed&&!ok?'err':'ok',(ok?'✅ Imported <strong>'+ok+'</strong> recipe'+(ok!==1?'s':'')+'. ':'')+(failed?'❌ '+failed+' could not be saved — check your connection and try again. ':'')+(ok?'<a href="#" onclick="showPage(\'recipes\');return false" style="color:inherit;font-weight:700">See them in All Recipes →</a>':''));
+  showToast(ok?'✅ Imported '+ok+' recipe'+(ok!==1?'s':''):'❌ Import failed');
+}
